	<string>LifeHub uses Face ID to unlock your private data quickly instead of typing your PIN.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
